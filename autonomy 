        "    def __init__(self, max_iter=50, tol=1e-4, nx=2, eps=1e-6):\n",
        "        super().__init__(max_iter=max_iter, tol=tol, nx=nx, eps=eps)\n",
        "\n",
        "    def parametric_bootstrap_lrt(self, sessions_dict, null_nx=1, alt_nx=2, n_bootstraps=50, alpha=0.05):\n",
        "        \"\"\"\n",
        "        Computes empirical null distribution of the likelihood ratio test statistic\n",
        "        via parametric bootstrap to avoid boundary violations in latent dimension testing.\n",
        "        \"\"\"\n",
        "        # 1. Fit Null Model\n",
        "        self.nx = null_nx\n",
        "        null_fit = self.fit_single_run_adaptive(sessions_dict)\n",
        "        if not null_fit[\"converged\"] and null_fit[\"status\"] != \"MAX_ITERATIONS_REACHED\":\n",
        "            return {\"error\": \"Null model failed convergence.\"}\n",
        "\n",
        "        ll_null_obs = null_fit[\"log_likelihood\"]\n",
        "\n",
        "        # 2. Fit Alternative Model\n",
        "        self.nx = alt_nx\n",
        "        alt_fit = self.fit_single_run_adaptive(sessions_dict)\n",
        "        if not alt_fit[\"converged\"] and alt_fit[\"status\"] != \"MAX_ITERATIONS_REACHED\":\n",
        "            return {\"error\": \"Alternative model failed convergence.\"}\n",
        "\n",
        "        ll_alt_obs = alt_fit[\"log_likelihood\"]\n",
        "        obs_stat = -2.0 * (ll_null_obs - ll_alt_obs)\n",
        "\n",
        "        # 3. Parametric Bootstrap Loop\n",
        "        boot_stats = []\n",
        "        null_params = null_fit[\"params\"]\n",
        "        first_session = list(sessions_dict.values())[0]\n",
        "        ny = first_session[\"Y\"].shape[1]\n",
        "        T = first_session[\"Y\"].shape[0]\n",
        "\n",
        "        for b in range(n_bootstraps):\n",
        "            np.random.seed(100 + b)\n",
        "            # Simulate data under null model\n",
        "            sim_smoother = ACIRobustKalmanSmootherV24(\n",
        "                null_params[\"A\"], null_params[\"C\"], null_params[\"Q\"], null_params[\"R\"],\n",
        "                np.zeros(null_nx), np.eye(null_nx)\n",
        "            )\n",
        "            # Forward simulate states and observations\n",
        "            X_sim = np.zeros((T, null_nx))\n",
        "            Y_sim = np.zeros((T, ny))\n",
        "            x = np.zeros(null_nx)\n",
        "            for t in range(T):\n",
        "                x = null_params[\"A\"] @ x + np.random.multivariate_normal(np.zeros(null_nx), null_params[\"Q\"])\n",
        "                X_sim[t] = x\n",
        "                Y_sim[t] = null_params[\"C\"] @ x + np.random.multivariate_normal(np.zeros(ny), null_params[\"R\"])\n",
        "\n",
        "            sim_sessions = {\"boot_session\": {\"Y\": Y_sim, \"mask\": ~np.isnan(Y_sim)}}\n",
        "\n",
        "            # Fit null and alt on bootstrap sample\n",
        "            self.nx = null_nx\n",
        "            b_null = self.fit_single_run_adaptive(sim_sessions)\n",
        "            self.nx = alt_nx\n",
        "            b_alt = self.fit_single_run_adaptive(sim_sessions)\n",
        "\n",
        "            if b_null[\"converged\"] and b_alt[\"converged\"]:\n",
        "                b_stat = -2.0 * (b_null[\"log_likelihood\"] - b_alt[\"log_likelihood\"])\n",
        "                boot_stats.append(max(0.0, b_stat))\n",
        "\n",
        "        if not boot_stats:\n",
        "            return {\"error\": \"All bootstrap iterations failed convergence.\"}\n",
        "\n",
        "        boot_stats = np.array(boot_stats)\n",
        "        p_value = np.mean(boot_stats >= obs_stat)\n",
        "\n",
        "        return {\n",
        "            \"null_nx\": null_nx,\n",
        "            \"alt_nx\": alt_nx,\n",
        "            \"observed_test_statistic\": float(obs_stat),\n",
        "            \"parametric_bootstrap_p_value\": float(p_value),\n",
        "            \"reject_null_at_alpha\": bool(p_value < alpha),\n",
        "            \"bootstrap_samples_count\": len(boot_stats)\n",
        "        }\n",
