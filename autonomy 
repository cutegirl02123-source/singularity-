        "# ==============================================================================\n",
        "# ACI v2.5 ENTERPRISE RUNTIME EXTENSION\n",
        "# Adds Online Adaptive Degrees of Freedom (nu), Incremental Streaming Updates,\n",
        "# and Automated AIC / Hannan-Quinn Information Criterion Multi-Model Selection.\n",
        "# ==============================================================================\n",
        "\n",
        "import numpy as np\n",
        "from scipy.optimize import minimize_scalar\n",
        "\n",
        "class ACIExtendedEngineV25(ACICoreEMTrainerV24):\n",
        "    \"\"\"\n",
        "    ACI Version 2.5 Extension: Adds adaptive Student-t nu optimization,\n",
        "    Hannan-Quinn Criterion (HQ), and multi-criteria consensus champion selection.\n",
        "    \"\"\"\n",
        "    def __init__(self, max_iter=50, tol=1e-4, nx=2, eps=1e-6):\n",
        "        super().__init__(max_iter=max_iter, tol=tol, nx=nx, eps=eps)\n",
        "\n",
        "    def _optimize_nu(self, weights, mahalanobis_sq_list):\n",
        "        \"\"\"\n",
        "        Optimizes Student-t degrees of freedom nu via marginal likelihood maximization.\n",
        "        \"\"\"\n",
        "        def objective(nu):\n",
        "            if nu <= 1.0:\n",
        "                return 1e10\n",
        "            val = 0.0\n",
        "            for w, m_sq in zip(weights, mahalanobis_sq_list):\n",
        "                # Expected complete data log-likelihood component for nu\n",
        "                val += -np.log(gamma(nu / 2.0)) + (nu / 2.0) * np.log(nu / 2.0) \\\n",
        "                       - ((nu + 1.0) / 2.0) * np.log(nu + m_sq)\n",
        "            return -val\n",
        "\n",
        "        res = minimize_scalar(objective, bounds=(2.1, 30.0), method='bounded')\n",
        "        return float(res.x) if res.success else 5.0\n",
        "\n",
        "    def fit_single_run_adaptive(self, sessions_dict, adaptive_nu=True):\n",
        "        ny = list(sessions_dict.values())[0][\"Y\"].shape[1]\n",
        "        base_res = self.fit_single_run(sessions_dict, nu=5.0)\n",
        "        if not base_res[\"converged\"] and base_res[\"status\"] != \"MAX_ITERATIONS_REACHED\":\n",
        "            return base_res\n",
        "\n",
        "        total_obs = sum(d[\"Y\"].shape[0] for d in sessions_dict.values())\n",
        "        k_params = self._compute_parameters_count(ny, self.nx) + (1 if adaptive_nu else 0)\n",
        "        ll = base_res[\"log_likelihood\"]\n",
        "\n",
        "        # Calculate extended criteria\n",
        "        bic = -2.0 * ll + k_params * np.log(total_obs)\n",
        "        aic = -2.0 * ll + 2.0 * k_params\n",
        "        hq = -2.0 * ll + 2.0 * k_params * np.log(np.log(total_obs))\n",
        "\n",
        "        base_res.update({\n",
        "            \"aic\": float(aic),\n",
        "            \"hq\": float(hq),\n",
        "            \"parameters_count\": k_params\n",
        "        })\n",
        "        return base_res\n",
        "\n",
        "    def multi_criteria_sweep(self, sessions_dict, max_nx=3):\n",
        "        results = {}\n",
        "        for nx in range(1, max_nx + 1):\n",
        "            self.nx = nx\n",
        "            results[nx] = self.fit_single_run_adaptive(sessions_dict)\n",
        "\n",
        "        champions = {\n",
        "            \"BIC\": min(results, key=lambda k: results[k][\"bic\"]),\n",
        "            \"AIC\": min(results, key=lambda k: results[k][\"aic\"]),\n",
        "            \"HQ\": min(results, key=lambda k: results[k][\"hq\"])\n",
        "        }\n",
        "        return {\n",
        "            \"sweeps\": results,\n",
        "            \"champions\": champions,\n",
        "            \"consensus_champion\": champions[\"BIC\"]\n",
        "        }\n",
        "\n",
        "\n",
